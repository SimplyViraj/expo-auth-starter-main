# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local editor and assistant settings
.vscode/
.claude/
.cloud/

# private planning document (kept outside repository history)
docs/EXPO_AUTH_STARTER_PLAN.md

# local environment files and secrets
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Backend build, local package cache, and test coverage
backend/.npm-cache/
backend/coverage/

# Relocated mobile native projects and test/cache output
/mobile/ios
/mobile/android
mobile/coverage/
mobile/.npm-cache/

# Private database backups and baseline review files
backend/.backups/
backend/.baseline-review/
