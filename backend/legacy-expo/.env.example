# For the new Nest server, use backend/.env.example for server values and set
# EXPO_PUBLIC_API_URL=http://localhost:3000 here. Values below support the legacy Expo API.

# Server-only PostgreSQL connection. Never prefix this with EXPO_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: npx auth secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Origin hosting the Expo API routes. Better Auth adds /api/auth itself.
BETTER_AUTH_URL=http://localhost:8081

# Client-visible origin for Better Auth and application API requests.
# Local native development automatically replaces localhost with Expo's
# reachable development-server address. Use HTTPS for deployed builds.
EXPO_PUBLIC_API_URL=http://localhost:8081
EXPO_PUBLIC_APP_ENV=development

# Optional comma-separated HTTPS web origins that may call Better Auth.
# The native app scheme and BETTER_AUTH_URL are trusted automatically.
AUTH_TRUSTED_ORIGINS=

# Server-only Resend delivery. onboarding@resend.dev can send only to the
# email address belonging to your Resend account until you verify a domain.
EMAIL_FROM=Expo Auth Starter <onboarding@resend.dev>
RESEND_API_KEY=re_replace_with_your_server_only_key

# Google OAuth in Expo Go uses the Web client and browser-based OAuth.
# Client IDs are public by design; only the Web client secret is server-only.
# iOS and Android client IDs are optional and used by native builds.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional local/EAS iOS signing team. Keep the real account-specific value
# in the ignored .env file; it is not part of Apple authentication itself.
# APPLE_TEAM_ID=
