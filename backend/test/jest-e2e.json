{
  "rootDir": "..",
  "preset": "ts-jest/presets/default-esm",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/**/*.e2e-spec.ts"
  ],
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "globalSetup": "<rootDir>/test/global-setup.cjs",
  "setupFiles": [
    "<rootDir>/test/environment.cjs"
  ],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "testTimeout": 30000
}