# Server only. Run commands from backend/. Use a NEW database (see README).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expo_auth?schema=public
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Exact browser origins. Native scheme comes from ../shared/app-identity.json.
AUTH_TRUSTED_ORIGINS=http://localhost:8081
EMAIL_FROM=Expo Auth Starter <onboarding@resend.dev>
RESEND_API_KEY=re_replace_with_a_real_server_key
# Optional Google: web ID and secret required together; native IDs optional.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Required to finish phone onboarding and use SMS login. All three must be set together.
# Create a Twilio Verify Service with six-digit SMS codes (default ten-minute validity).
# Development can start without them; phone endpoints fail closed. Required in production.
# TWILIO_ACCOUNT_SID=AC_your_account_sid
# TWILIO_AUTH_TOKEN=your_server_only_auth_token
# TWILIO_VERIFY_SERVICE_SID=VA_your_verify_service_sid
